# The client certificate Common Name (CN) must be the robotId.
pattern write robots/%u/telemetry
pattern write robots/%u/status
pattern write robots/%u/alerts
pattern write robots/%u/commands/ack
pattern read  robots/%u/commands

# Issue the backend a client certificate whose CN is "gilbom".
user gilbom
topic read  robots/+/telemetry
topic read  robots/+/status
topic read  robots/+/alerts
topic read  robots/+/commands/ack
topic write robots/+/commands
