# OrinCar 실기 주입값 — 이 파일을 orincar.env 로 복사해서 채운다.
#
#   cp scripts/orincar.env.example scripts/orincar.env
#   chmod 600 scripts/orincar.env
#
# ⚠️ orincar.env 는 커밋 금지다 (.gitignore 에 있다). 비밀번호·API Key 원문이 들어간다.
# ⚠️ 값에 따옴표를 붙이지 않는다. systemd EnvironmentFile 은 따옴표를 값의 일부로 읽는다.
#
# 출처: 관리자 화면 → 로봇 등록 → MQTT Credential 최초 발급.
#       비밀번호는 발급 성공 Modal 에서 딱 한 번만 보인다. 놓치면 회전해서 새로 받아야 한다.

# ── 로봇 등록 응답 ────────────────────────────────────────────────────────────
# DB 내부 PK. 증거 이미지 업로드 form 의 robot_id 에 들어간다.
# ⚠️ mqttId 가 아니다. 서버가 UUID.fromString() 으로 파싱하므로 mqttId 를 넣으면
#    400 이 떨어지고 결함 사진이 전부 안 붙는다.
ROBOT_UUID=

# 외부 로봇 식별자. topic 세그먼트와 payload 의 mqtt_id 가 전부 이 값이다.
MQTT_ID=

# ── Credential 발급 응답 ──────────────────────────────────────────────────────
# 현재 서버는 username·clientId 를 둘 다 mqttId 로 돌려준다. 그래도 항목은 분리해 둔다.
# username 은 브로커 ACL 이 %u 로 쓰므로 MQTT_ID 와 반드시 같아야 한다 —
# 다르면 기동 시 거부한다(접속은 되는데 발행이 전부 거부되는 상태를 막기 위해).
MQTT_USERNAME=

# 발급 시 1회만 노출되는 값.
MQTT_PASSWORD=

# 접속 세션 식별자. 계약에 없는 값이라 mqtt_id 와 달라도 된다 — 원하는 값을 쓰면 된다.
# 비워 두면 MQTT_ID 를 쓴다. 같은 client_id 로 두 번 붙으면 브로커가 먼저 붙은 쪽을
# 끊는다("session taken over") — 한 계정으로 두 프로세스를 띄울 때만 다르게 준다.
MQTT_CLIENT_ID=

# ── 브로커 ────────────────────────────────────────────────────────────────────
MQTT_HOST=i15d101.p.ssafy.io
MQTT_PORT=8883

# 브로커 인증서 검증 방법. 비워 두면 system — OS 신뢰 저장소로 검증한다.
# 운영 브로커는 Let's Encrypt 라 이걸로 충분하다 (ca-certificates 패키지 필요).
# 사설 CA 브로커를 검증할 때만 Jetson 안의 CA 파일 절대경로를 준다.
MQTT_CA_CERT=

# ⚠️ MQTT_QOS 는 로봇에 없다. QoS 는 topic 마다 계약이 고정하고 있어
#    (comms/topics.py: PUBLISH_POLICY) 설정으로 열지 않는다. 웹의 MQTT_QOS=1 은
#    서버 구독 설정이고, 그걸 0 으로 내리면 QoS 1 topic 7종이 전부 거부된다.

# ── 증거 이미지 업로드 (선택) ─────────────────────────────────────────────────
# 로봇용 X-API-Key 발급 경로가 아직 없다. 비워 두면 이미지 업로드만 건너뛰고
# MQTT 는 전부 정상 동작한다. 결함 event 는 image_id: null 로 발행된다.
UPLOAD_URL=
UPLOAD_API_KEY=
