pipeline {
    agent any

    options {
        // 동일 Job의 이전 빌드가 같은 로컬 image tag를 덮어쓰지 않게 한다.
        disableConcurrentBuilds(abortPrevious: true)
        skipDefaultCheckout(true)
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    // 저장소 root가 common-proj인 경우와 web 자체인 경우를 모두 지원한다.
                    env.APP_DIR = fileExists('web/compose.yaml') ? 'web' : '.'
                    env.COMPOSE_PROJECT_NAME = (
                            "gilbom-ci-${env.JOB_NAME}-${env.BUILD_NUMBER}"
                                    .toLowerCase()
                                    .replaceAll('[^a-z0-9_-]', '-')
                                    .take(63)
                    )
                }
            }
        }

        stage('Prepare ephemeral credentials') {
            steps {
                dir(env.APP_DIR) {
                    // CI Secret도 environment가 아니라 build별 ignored 파일로 만들고
                    // Compose가 runtime에 /run/secrets로만 mount한다.
                    sh '''
                        set +x
                        set -eu
                        umask 077
                        mkdir -p secrets

                        openssl rand -hex 32 > secrets/postgres_admin_password
                        openssl rand -hex 32 > secrets/postgres_flyway_password
                        openssl rand -hex 32 > secrets/postgres_app_password
                        openssl rand -hex 32 > secrets/mqtt_backend_password
                        openssl rand -base64 48 \
                            | tr -d '\\n' > secrets/gilbom_storage_signing_key
                        openssl rand -base64 48 \
                            | tr -d '\\n' > secrets/gilbom_auth_rate_limit_hmac_key
                        printf '1=' > secrets/gilbom_mfa_totp_keyring
                        openssl rand -base64 32 \
                            | tr -d '\\n' >> secrets/gilbom_mfa_totp_keyring

                        # LLM과 초기 관리자는 CI smoke에서 비활성화한다.
                        : > secrets/gilbom_llm_api_key
                        : > secrets/gilbom_initial_admin_password
                        # Compose file secrets preserve host mode. The 0700 parent
                        # blocks host traversal and 0444 lets UID 1883 read the
                        # read-only container mount.
                        chmod 444 secrets/*
                    '''
                }
                script {
                    // 검증은 컨테이너 내부에서 하므로 host port는 임의 포트(0)를 사용해 충돌을 피한다.
                    env.POSTGRES_PORT = '0'
                    env.BACKEND_PORT = '0'
                    env.FRONTEND_PORT = '0'
                    env.MQTT_TLS_PORT = '0'
                }
            }
        }

        stage('Repository policy') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu

                        # 실제 .env, secrets/와 대표적인 개인키/keystore 확장자는
                        # 추적되면 즉시 실패시킨다. secrets 전체를 ignore하기 위한
                        # 빈 디렉터리 정책 파일 secrets/.gitignore만 허용한다.
                        if git ls-files --full-name \
                            | grep -E '(^|/)\\.env$|(^|/)secrets/|\\.(pem|key|p12|pfx|jks|keystore)$|(^|/)passwd$|(^|/)credentials\\.json$|(^|/)service-account[^/]*\\.json$' \
                            | grep -Ev '(^|/)secrets/\\.gitignore$'; then
                            echo 'Tracked secret file candidate detected.' >&2
                            exit 1
                        fi

                        # 대표적인 provider token과 PEM 개인키 본문이 일반 소스에 들어오면 CI에서 막는다.
                        if git grep -IlE -e \
                            'AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|glpat-[A-Za-z0-9_-]{20,}|github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}' \
                            -- . ':!frontend/gilbom/package-lock.json'; then
                            echo 'Tracked token candidate detected.' >&2
                            exit 1
                        fi
                        if git grep -IlE -e \
                            '-----BEGIN( [A-Z0-9]+)? PRIVATE KEY-----' \
                            -- . ':!backend/src/main/java/com/gilbom/robot/mqtt/strategy/PemSslContextSupport.java'; then
                            echo 'Tracked private key candidate detected.' >&2
                            exit 1
                        fi

                        # 필수 환경 변수가 모두 해석되는지도 image build 전에 확인한다.
                        docker compose config --quiet
                        sh scripts/verify-secret-boundary.sh
                        sh scripts/verify-production-compose.sh
                        sh scripts/verify-certbot-automation.sh
                        sh scripts/verify-day8-infrastructure.sh
                        sh scripts/verify-frontend-csp-source.sh
                        sh -n infra/scripts/*.sh
                        test -s docs/production-deployment-runbook.md
                        test -s docs/day7-completion-freeze.md

                        # 개발자 선언과 Docker/lockfile의 지원 버전이 어긋나면 빌드하지 않는다.
                        sh scripts/verify-supported-versions.sh

                        # 통계 path·DTO·권한·오류 코드 정본이 한 변경에서 함께
                        # 유지되는지 런타임 빌드 전에 확인한다.
                        sh scripts/verify-statistics-contract.sh
                    '''
                }
            }
        }

        stage('Backend full test and Day 4 security acceptance') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu

                        project_dir="$(pwd)"
                        host_uid="$(id -u)"
                        host_gid="$(id -g)"
                        test_home=/test-home

                        # 개발자 host socket과 운영 Jenkins의 TLS DinD를 모두
                        # 지원한다. 어느 경로든 Testcontainers가 실제 DB를
                        # 기동하며 test skip은 실패로 처리한다.
                        if [ -S /var/run/docker.sock ]; then
                            docker_socket_gid="$(
                                stat -c '%g' /var/run/docker.sock
                            )"
                            docker run --rm \
                                --user "$host_uid:$host_gid" \
                                --group-add "$docker_socket_gid" \
                                --add-host host.docker.internal:host-gateway \
                                --env DOCKER_HOST=unix:///var/run/docker.sock \
                                --env TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock \
                                --env TESTCONTAINERS_HOST_OVERRIDE=host.docker.internal \
                                --env HOME="$test_home" \
                                --env GRADLE_USER_HOME="$test_home/.gradle" \
                                --env JAVA_TOOL_OPTIONS=-Duser.home="$test_home" \
                                --volume /var/run/docker.sock:/var/run/docker.sock \
                                --volume "$project_dir/backend:$project_dir/backend:ro" \
                                --tmpfs "$test_home:rw,nosuid,nodev,uid=$host_uid,gid=$host_gid,mode=0700" \
                                --workdir "$project_dir/backend" \
                                amazoncorretto:21.0.12-alpine3.22 \
                                sh -ec '
                                    sh ./gradlew \
                                        --project-cache-dir /test-home/project-cache \
                                        -PisolatedBuildDirectory=/test-home/build \
                                        test \
                                        securityAcceptanceTest \
                                        --no-daemon \
                                        --rerun-tasks
                                '
                        else
                            test -n "${DOCKER_HOST:-}"
                            test "${DOCKER_TLS_VERIFY:-}" = "1"
                            test -r "${DOCKER_CERT_PATH:-/certs/client}/ca.pem"

                            docker run --rm \
                                --user "$host_uid:$host_gid" \
                                --add-host docker:host-gateway \
                                --env DOCKER_HOST="$DOCKER_HOST" \
                                --env DOCKER_TLS_VERIFY=1 \
                                --env DOCKER_CERT_PATH=/certs/client \
                                --env TESTCONTAINERS_HOST_OVERRIDE=docker \
                                --env HOME="$test_home" \
                                --env GRADLE_USER_HOME="$test_home/.gradle" \
                                --env JAVA_TOOL_OPTIONS=-Duser.home="$test_home" \
                                --volume /certs/client:/certs/client:ro \
                                --volume "$project_dir/backend:$project_dir/backend:ro" \
                                --tmpfs "$test_home:rw,nosuid,nodev,uid=$host_uid,gid=$host_gid,mode=0700" \
                                --workdir "$project_dir/backend" \
                                amazoncorretto:21.0.12-alpine3.22 \
                                sh -ec '
                                    sh ./gradlew \
                                        --project-cache-dir /test-home/project-cache \
                                        -PisolatedBuildDirectory=/test-home/build \
                                        test \
                                        securityAcceptanceTest \
                                        --no-daemon \
                                        --rerun-tasks
                                '
                        fi
                    '''
                }
            }
        }

        stage('Build and test images') {
            steps {
                dir(env.APP_DIR) {
                    // backend image는 Gradle test, frontend image는 lint와 production build를 포함한다.
                    sh '''
                        set -eu
                        docker compose \
                            -f compose.build.yaml \
                            build backend frontend mqtt-init
                        sh scripts/test-verify-production-images.sh
                        IMAGE_VERIFY_WORK_ROOT=.artifacts/image-verify-work \
                            IMAGE_SECURITY_OUTPUT_DIR=.artifacts/image-security \
                            IMAGE_SCANNER_MODE=auto \
                            sh scripts/verify-production-images.sh
                        sh scripts/verify-frontend-tls.sh
                    '''
                    archiveArtifacts(
                            artifacts: '.artifacts/image-security/**',
                            allowEmptyArchive: false,
                            fingerprint: true
                    )
                }
            }
        }

        stage('Integration smoke test') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu

                        # 단순 container 실행 여부가 아니라 모든 health dependency가 준비될 때까지 기다린다.
                        docker compose up --detach --no-build --wait --wait-timeout 180

                        # 프론트 Nginx -> 백엔드 API 경로를 호출해 실제 서비스 간 연결을 검증한다.
                        docker compose exec -T frontend \
                            wget -qO- http://127.0.0.1:8080/healthz \
                            | grep -Fx 'ok'
                        docker compose exec -T frontend \
                            wget -qO- http://127.0.0.1:8080/api/health \
                            | grep -F '"status":"UP"'

                        # 전체 Actuator health에는 DB contributor가 포함돼 Backend -> DB 연결도 확인된다.
                        docker compose exec -T frontend \
                            wget -qO- http://backend:8080/actuator/health \
                            | grep -F '"status":"UP"'

                        # 실제 CI Secret과 민감 request canary가 Backend/Nginx
                        # container log에 남지 않았는지 검증한다.
                        BACKEND_CONTAINER="$(docker compose ps -q backend)" \
                        FRONTEND_CONTAINER="$(docker compose ps -q frontend)" \
                        SECRET_SCAN_DIR=secrets \
                        IMAGE_VERIFY_MODE=logs \
                            sh scripts/verify-production-images.sh

                        # MQTT/DB를 각각 종료·복구하며 liveness와 readiness의
                        # 장애 격리 정책을 실제 container에서 검증한다.
                        sh scripts/verify-backend-health-policy.sh

                        # BrowserRouter deep link가 Nginx fallback을 통해 React 진입점으로 연결돼야 한다.
                        docker compose exec -T frontend \
                            wget -qO- http://127.0.0.1:8080/robots \
                            | grep -F '<div id="root"></div>'

                        # 빈 DB의 extension, V1~V35, RBAC seed와 runtime 최소 권한을 계약 SQL로 확인한다.
                        docker compose exec -T db sh -ec '
                            export PGPASSWORD="$(cat "$POSTGRES_PASSWORD_FILE")"
                            psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" \
                                --no-password \
                                --set "flyway_role=$POSTGRES_FLYWAY_USER" \
                                --set "application_role=$POSTGRES_APP_USER"
                        ' < infra/postgres/verify-empty-database.sql

                        # 실제 CSRF 요청이 JDBC Session과 attribute를 DB에 쓰는지 확인한다.
                        docker compose exec -T frontend \
                            wget -qO- http://127.0.0.1:8080/api/v1/auth/csrf-token \
                            | grep -Fq '"headerName":"X-CSRF-TOKEN"'
                        docker compose exec -T db sh -ec '
                            export PGPASSWORD="$(cat "$POSTGRES_PASSWORD_FILE")"
                            psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" \
                                --no-password --tuples-only --no-align --command "
                                    SELECT (
                                        (SELECT COUNT(*) FROM session_store.spring_session) >= 1
                                        AND
                                        (SELECT COUNT(*) FROM session_store.spring_session_attributes) >= 1
                                    )::int;
                                "
                        ' | grep -qx '1'

                        # Runtime role DML과 audit/report append-only 보호를 실제 권한으로 검증한다.
                        docker compose exec -T db sh -ec '
                            export PGPASSWORD="$(cat "$POSTGRES_APP_PASSWORD_FILE")"
                            psql --host 127.0.0.1 --username "$POSTGRES_APP_USER" \
                                --dbname "$POSTGRES_DB" --no-password
                        ' < infra/postgres/verify-initial-schema.sql
                        docker compose exec -T db sh -ec '
                            export PGPASSWORD="$(cat "$POSTGRES_FLYWAY_PASSWORD_FILE")"
                            psql --host 127.0.0.1 --username "$POSTGRES_FLYWAY_USER" \
                                --dbname "$POSTGRES_DB" --no-password
                        ' < infra/postgres/verify-append-only.sql

                        # DB 응답을 기다리는 실제 요청을 유지한 채 SIGTERM을 보내
                        # 요청 완료와 30초 내 graceful shutdown을 함께 검증한다.
                        sh scripts/verify-backend-graceful-shutdown.sh
                    '''
                }
            }
        }

        stage('Build resource evidence') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        mkdir -p .artifacts/runtime
                        {
                            date -u '+captured_at=%Y-%m-%dT%H:%M:%SZ'
                            echo 'memory'
                            free -h
                            echo 'root-filesystem'
                            df -h /
                            echo 'docker-storage'
                            docker system df
                            echo 'running-container-usage'
                            docker stats --no-stream \
                                --format '{{.Name}} cpu={{.CPUPerc}} memory={{.MemUsage}} pids={{.PIDs}}'
                        } > .artifacts/runtime/build-resources.txt
                    '''
                    archiveArtifacts(
                            artifacts: '.artifacts/runtime/build-resources.txt',
                            allowEmptyArchive: false,
                            fingerprint: true
                    )
                }
            }
        }

        stage('Container report and resilience smoke') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu

                        # 앞 단계의 CI stack을 먼저 정리해 agent에서 DB 두 개가
                        # 동시에 메모리를 점유하지 않게 한다. 보고서 smoke는 별도
                        # project와 새 named volume을 만들고 종료 시 자체 폐기한다.
                        docker compose down --volumes --remove-orphans

                        # 이미 검증·빌드한 운영 image로 보고서 전체 흐름에 이어
                        # PID/DB/MQTT/LLM 장애, 자동 재시작과 volume 영속성을 검증한다.
                        REPORT_SMOKE_SKIP_BUILD=true \
                            sh scripts/container-resilience-smoke.sh
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                if (env.APP_DIR) {
                    dir(env.APP_DIR) {
                        // CI DB와 생성된 MQTT 자산은 재사용하지 않아 매번 빈 환경을 검증한다.
                        sh 'docker compose down --volumes --remove-orphans || true'
                    }
                }
            }
        }
        cleanup {
            deleteDir()
        }
    }
}
