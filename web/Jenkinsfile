pipeline {
    agent any

    // Stage 15: source 변경 감지는 CI Job에만 둔다. 운영 배포·Rollback은
    // full SHA 입력과 인증 사용자 승인 없이는 시작되지 않는다.
    triggers {
        pollSCM('H/5 * * * *')
    }

    options {
        disableConcurrentBuilds(abortPrevious: true)
        skipDefaultCheckout(true)
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
    }

    stages {
        stage('Checkout') {
            steps {
                sh '''
                    set -eu
                    workspace_uid="$(id -u)"
                    workspace_gid="$(id -g)"
                    for mqtt_local in \
                        "$WORKSPACE/web/infra/mosquitto/local" \
                        "$WORKSPACE/infra/mosquitto/local"
                    do
                        [ -d "$mqtt_local" ] || continue
                        docker run --rm \
                            --user 0:0 \
                            --network none \
                            --read-only \
                            --cap-drop ALL \
                            --cap-add CHOWN \
                            --cap-add DAC_OVERRIDE \
                            --cap-add FOWNER \
                            --security-opt no-new-privileges:true \
                            --env WORKSPACE_UID="$workspace_uid" \
                            --env WORKSPACE_GID="$workspace_gid" \
                            --volume "$mqtt_local:/mqtt-local" \
                            --entrypoint /bin/sh \
                            eclipse-mosquitto:2.1.2-alpine \
                            -ec '
                                for target in /mqtt-local/ca /mqtt-local/runtime
                                do
                                    [ -d "$target" ] || continue
                                    [ ! -L "$target" ] || {
                                        echo "Refusing symlinked MQTT workspace target: $target" >&2
                                        exit 1
                                    }
                                    chown -R "$WORKSPACE_UID:$WORKSPACE_GID" "$target"
                                    chmod -R u+rwX "$target"
                                done
                            '
                    done
                '''
                checkout scm
                script {
                    env.APP_DIR = fileExists('web/compose.yaml') ? 'web' : '.'

                    def shallowRepository = sh(
                            label: 'Verify full Git checkout',
                            returnStdout: true,
                            script: 'git rev-parse --is-shallow-repository'
                    ).trim()
                    echo "git rev-parse --is-shallow-repository: ${shallowRepository}"
                    if (shallowRepository != 'false') {
                        error('Full Git checkout is required; shallow repository detected')
                    }

                    def releaseSha = sh(
                            label: 'Resolve release commit SHA',
                            returnStdout: true,
                            script: 'git rev-parse HEAD'
                    ).trim()
                    if (!releaseSha.matches('[0-9a-f]{40}')) {
                        error("Invalid release SHA: ${releaseSha}")
                    }
                    env.RELEASE_SHA = releaseSha
                    env.BACKEND_IMAGE = "gilbom-backend:${releaseSha}"
                    env.FRONTEND_IMAGE = "gilbom-frontend:${releaseSha}"
                    env.BUILD_STARTED_AT_UTC = sh(
                            returnStdout: true,
                            script: "date -u '+%Y-%m-%dT%H:%M:%SZ'"
                    ).trim()
                    echo "RELEASE_SHA=${env.RELEASE_SHA}"
                    echo "BACKEND_IMAGE=${env.BACKEND_IMAGE}"
                    echo "FRONTEND_IMAGE=${env.FRONTEND_IMAGE}"

                    env.COMPOSE_PROJECT_NAME = (
                            "gilbom-ci-${env.JOB_NAME}-${env.BUILD_NUMBER}"
                                    .toLowerCase()
                                    .replaceAll('[^a-z0-9_-]', '-')
                                    .take(63)
                    )
                }
                dir(env.APP_DIR) {
                    sh 'sh scripts/record-ci-result.sh checkout-full'
                }
            }
        }

        // Stage 4: 모든 source 검사는 임시 CI Secret 생성 전에 fail-fast 한다.
        stage('Repository policy') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        SOURCE_SECURITY_OUTPUT_DIR=.artifacts/source-security \
                        SECURITY_WORK_ROOT=.artifacts/security-work \
                            sh scripts/verify-source-security.sh reset
                        sh scripts/verify-repository-policy.sh
                        sh scripts/record-ci-result.sh repository-policy
                    '''
                }
            }
        }

        stage('Git history Secret scan') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        SOURCE_SECURITY_OUTPUT_DIR=.artifacts/source-security \
                        SECURITY_WORK_ROOT=.artifacts/security-work \
                            sh scripts/verify-source-security.sh history
                        sh scripts/record-ci-result.sh git-history-secret
                    '''
                }
            }
        }

        stage('Checkout workspace Secret scan') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        SOURCE_SECURITY_OUTPUT_DIR=.artifacts/source-security \
                        SECURITY_WORK_ROOT=.artifacts/security-work \
                            sh scripts/verify-source-security.sh workspace
                        sh scripts/record-ci-result.sh workspace-secret
                    '''
                }
            }
        }

        stage('Secret boundary') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        sh scripts/verify-secret-boundary.sh
                        sh scripts/record-ci-result.sh secret-boundary
                    '''
                }
            }
        }

        stage('Supported runtime versions') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        sh scripts/verify-supported-versions.sh
                        sh scripts/record-ci-result.sh supported-runtime
                    '''
                }
            }
        }

        stage('Production Compose contract') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        docker compose config --quiet
                        sh scripts/verify-production-compose.sh
                        sh scripts/record-ci-result.sh production-compose
                    '''
                }
            }
        }

        stage('OpenAPI lint') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        SOURCE_SECURITY_OUTPUT_DIR=.artifacts/source-security \
                        SECURITY_WORK_ROOT=.artifacts/security-work \
                            sh scripts/verify-source-security.sh openapi
                        sh scripts/record-ci-result.sh openapi-lint
                    '''
                }
            }
        }

        stage('Backend dependency scan') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        SOURCE_SECURITY_OUTPUT_DIR=.artifacts/source-security \
                        SECURITY_WORK_ROOT=.artifacts/security-work \
                            sh scripts/verify-source-security.sh backend-dependencies
                        sh scripts/record-ci-result.sh backend-dependency-scan
                    '''
                }
            }
        }

        stage('Frontend dependency scan') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        SOURCE_SECURITY_OUTPUT_DIR=.artifacts/source-security \
                        SECURITY_WORK_ROOT=.artifacts/security-work \
                            sh scripts/verify-source-security.sh frontend-dependencies
                        SOURCE_SECURITY_OUTPUT_DIR=.artifacts/source-security \
                        SECURITY_WORK_ROOT=.artifacts/security-work \
                            sh scripts/verify-source-security.sh dependency-policy
                        sh scripts/record-ci-result.sh frontend-dependency-scan
                    '''
                }
            }
        }

        stage('Image scanner readiness') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        IMAGE_SECURITY_OUTPUT_DIR=.artifacts/image-security \
                        IMAGE_SECURITY_WORK_ROOT=.artifacts/image-security-work \
                            sh scripts/scan-image-security.sh prepare
                        sh scripts/record-ci-result.sh image-scanner-readiness
                    '''
                }
            }
        }

        stage('Artifact transfer readiness') {
            steps {
                dir(env.APP_DIR) {
                    withCredentials([
                        sshUserPrivateKey(
                                credentialsId: 'gilbom-artifact-upload-ssh',
                                keyFileVariable: 'ARTIFACT_SSH_IDENTITY',
                                usernameVariable: 'ARTIFACT_SSH_USER'
                        ),
                        file(
                                credentialsId: 'gilbom-artifact-known-hosts',
                                variable: 'ARTIFACT_KNOWN_HOSTS'
                        )
                    ]) {
                        sh '''
                            set -eu
                            set +x
                            artifact_host="${ARTIFACT_HOST:-host.docker.internal}"
                            artifact_port="${ARTIFACT_SSH_PORT:-22}"
                            KNOWN_HOSTS_FILE="$ARTIFACT_KNOWN_HOSTS" \
                            SSH_IDENTITY_FILE="$ARTIFACT_SSH_IDENTITY" \
                            SSH_PORT="$artifact_port" \
                                sh scripts/verify-ci-artifact-remote-readiness.sh \
                                    "$ARTIFACT_SSH_USER@$artifact_host"
                            sh scripts/record-ci-result.sh artifact-transfer-readiness
                        '''
                    }
                }
            }
        }

        stage('Prepare ephemeral credentials') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set +x
                        set -eu
                        umask 077
                        mkdir -p secrets
                        openssl rand -hex 32 > secrets/postgres_admin_password
                        openssl rand -hex 32 > secrets/postgres_flyway_password
                        openssl rand -hex 32 > secrets/postgres_app_password
                        openssl rand -hex 32 > secrets/mqtt_backend_password
                        openssl rand -base64 48 \
                            | tr -d '\\n' > secrets/gilbom_storage_signing_key
                        openssl rand -base64 48 \
                            | tr -d '\\n' > secrets/gilbom_auth_rate_limit_hmac_key
                        printf '1=' > secrets/gilbom_mfa_totp_keyring
                        openssl rand -base64 32 \
                            | tr -d '\\n' >> secrets/gilbom_mfa_totp_keyring
                        : > secrets/gilbom_llm_api_key
                        : > secrets/gilbom_initial_admin_password
                        chmod 444 secrets/*
                    '''
                }
                script {
                    env.POSTGRES_PORT = '0'
                    env.BACKEND_PORT = '0'
                    env.FRONTEND_PORT = '0'
                    env.MQTT_TLS_PORT = '0'
                }
            }
        }

        // Stage 5: 기존 검증을 결과 단위로 분리해 실패 위치와 metadata를 명확히 한다.
        stage('Backend full test') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        sh scripts/run-backend-ci-task.sh test
                        sh scripts/record-ci-result.sh backend-test
                    '''
                }
            }
        }

        stage('Backend security acceptance') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        sh scripts/run-backend-ci-task.sh securityAcceptanceTest
                        sh scripts/record-ci-result.sh security-acceptance
                    '''
                }
            }
        }

        stage('Frontend test') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        sh scripts/run-frontend-ci-task.sh test
                        sh scripts/record-ci-result.sh frontend-test
                    '''
                }
            }
        }

        stage('Frontend lint') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        sh scripts/run-frontend-ci-task.sh lint
                        sh scripts/record-ci-result.sh frontend-lint
                    '''
                }
            }
        }

        stage('Frontend production build') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        sh scripts/run-frontend-ci-task.sh build
                        sh scripts/record-ci-result.sh frontend-production-build
                    '''
                }
            }
        }

        stage('Build full-SHA images') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        test "$BACKEND_IMAGE" = "gilbom-backend:$RELEASE_SHA"
                        test "$FRONTEND_IMAGE" = "gilbom-frontend:$RELEASE_SHA"
                        docker compose -f compose.build.yaml \
                            build backend frontend mqtt-init
                        sh scripts/test-verify-production-images.sh
                        sh scripts/record-ci-result.sh sha-image-build
                    '''
                }
            }
        }

        stage('Backend runtime image') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        sh scripts/verify-backend-runtime-image.sh "$BACKEND_IMAGE"
                        sh scripts/record-ci-result.sh backend-runtime-image
                    '''
                }
            }
        }

        stage('Frontend runtime image') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        sh scripts/verify-frontend-runtime-image.sh "$FRONTEND_IMAGE"
                        DOCKER_BIND_WORK_ROOT=.artifacts/docker-bind-work \
                            sh scripts/verify-frontend-tls.sh "$FRONTEND_IMAGE"
                        sh scripts/record-ci-result.sh frontend-runtime-image
                    '''
                }
            }
        }

        stage('Start integration stack') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        docker compose up --detach --no-build --wait --wait-timeout 180
                        sh scripts/record-ci-result.sh integration-stack-start
                    '''
                }
            }
        }

        stage('Flyway V1-V38') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        docker compose exec -T db sh -ec '
                            export PGPASSWORD="$(cat "$POSTGRES_PASSWORD_FILE")"
                            psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" \
                                --no-password --tuples-only --no-align --command "
                                    SELECT (
                                        COUNT(*) = 38
                                        AND MIN(version::INTEGER) = 1
                                        AND MAX(version::INTEGER) = 38
                                        AND BOOL_AND(success)
                                    )::int
                                    FROM flyway_history.flyway_schema_history;
                                "
                        ' | grep -qx 1
                        sh scripts/record-ci-result.sh flyway-v1-v38
                    '''
                }
            }
        }

        stage('PostGIS RBAC and Spring Session') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        docker compose exec -T db sh -ec '
                            export PGPASSWORD="$(cat "$POSTGRES_PASSWORD_FILE")"
                            psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" \
                                --no-password \
                                --set "flyway_role=$POSTGRES_FLYWAY_USER" \
                                --set "application_role=$POSTGRES_APP_USER"
                        ' < infra/postgres/verify-empty-database.sql
                        sh scripts/record-ci-result.sh postgis-rbac-session
                    '''
                }
            }
        }

        stage('CSRF permission and append-only audit') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        docker compose exec -T frontend \
                            wget -qO- http://127.0.0.1:8080/api/v1/auth/csrf-token \
                            | grep -Fq '"headerName":"X-CSRF-TOKEN"'
                        docker compose exec -T db sh -ec '
                            export PGPASSWORD="$(cat "$POSTGRES_PASSWORD_FILE")"
                            psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" \
                                --no-password --tuples-only --no-align --command "
                                    SELECT (
                                        (SELECT COUNT(*) FROM session_store.spring_session) >= 1
                                        AND
                                        (SELECT COUNT(*) FROM session_store.spring_session_attributes) >= 1
                                    )::int;
                                "
                        ' | grep -qx 1
                        docker compose exec -T db sh -ec '
                            export PGPASSWORD="$(cat "$POSTGRES_APP_PASSWORD_FILE")"
                            psql --host 127.0.0.1 --username "$POSTGRES_APP_USER" \
                                --dbname "$POSTGRES_DB" --no-password
                        ' < infra/postgres/verify-initial-schema.sql
                        docker compose exec -T db sh -ec '
                            export PGPASSWORD="$(cat "$POSTGRES_FLYWAY_PASSWORD_FILE")"
                            psql --host 127.0.0.1 --username "$POSTGRES_FLYWAY_USER" \
                                --dbname "$POSTGRES_DB" --no-password
                        ' < infra/postgres/verify-append-only.sql
                        sh scripts/record-ci-result.sh csrf-permission-audit
                    '''
                }
            }
        }

        stage('Integration smoke') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        docker compose exec -T frontend \
                            wget -qO- http://127.0.0.1:8080/healthz \
                            | grep -Fx ok
                        docker compose exec -T frontend \
                            wget -qO- http://127.0.0.1:8080/api/health \
                            | grep -F '"status":"UP"'
                        docker compose exec -T frontend \
                            wget -qO- http://backend:8080/actuator/health \
                            | grep -F '"status":"UP"'
                        docker compose exec -T frontend \
                            wget -qO- http://127.0.0.1:8080/robots \
                            | grep -F '<div id="root"></div>'
                        BACKEND_CONTAINER="$(docker compose ps -q backend)" \
                        FRONTEND_CONTAINER="$(docker compose ps -q frontend)" \
                        SECRET_SCAN_DIR=secrets \
                        IMAGE_VERIFY_MODE=logs \
                        IMAGE_SCANNER_MODE=off \
                            sh scripts/verify-production-images.sh
                        sh scripts/record-ci-result.sh container-log-secret
                        sh scripts/record-ci-result.sh integration-smoke
                    '''
                }
            }
        }

        stage('Graceful shutdown') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        sh scripts/verify-backend-graceful-shutdown.sh
                        sh scripts/record-ci-result.sh graceful-shutdown
                    '''
                }
            }
        }

        stage('Build resource evidence') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        mkdir -p .artifacts/runtime
                        {
                            date -u '+captured_at=%Y-%m-%dT%H:%M:%SZ'
                            echo memory
                            free -h
                            echo root-filesystem
                            df -h /
                            echo docker-storage
                            docker system df
                            echo running-container-usage
                            docker stats --no-stream \
                                --format '{{.Name}} cpu={{.CPUPerc}} memory={{.MemUsage}} pids={{.PIDs}}'
                        } > .artifacts/runtime/build-resources.txt
                        sh scripts/record-ci-result.sh build-resource-evidence
                    '''
                }
            }
        }

        stage('Report LLM fallback and resilience suite') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        docker compose down --volumes --remove-orphans
                        DOCKER_BIND_WORK_ROOT=.artifacts/docker-bind-work \
                        REPORT_SMOKE_FRONTEND_BIND_ADDRESS=0.0.0.0 \
                        REPORT_SMOKE_PUBLISHED_HOST=docker-builder \
                        REPORT_SMOKE_SKIP_BUILD=true \
                            sh scripts/container-resilience-smoke.sh
                        sh scripts/record-ci-result.sh report-llm-fallback
                        sh scripts/record-ci-result.sh resilience-recovery
                        sh scripts/record-ci-result.sh volume-persistence
                    '''
                }
            }
        }

        stage('Resilience recovery evidence') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        grep -Fxq PASS .artifacts/ci-results/resilience-recovery.status
                        echo "DB MQTT Backend recovery evidence: PASS"
                    '''
                }
            }
        }

        stage('Volume persistence evidence') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        grep -Fxq PASS .artifacts/ci-results/volume-persistence.status
                        echo "Image and report volume persistence evidence: PASS"
                    '''
                }
            }
        }

        stage('Image layer history and log Secret scan') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        grep -Fxq PASS .artifacts/ci-results/container-log-secret.status
                        IMAGE_VERIFY_WORK_ROOT=.artifacts/image-verify-work \
                        IMAGE_SECURITY_OUTPUT_DIR=.artifacts/image-security \
                        IMAGE_VERIFY_MODE=static \
                        IMAGE_SCANNER_MODE=off \
                            sh scripts/verify-production-images.sh
                        sh scripts/record-ci-result.sh image-layer-log-secret
                    '''
                }
            }
        }

        stage('Required image SBOM and CVE scan') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        BACKEND_IMAGE="$BACKEND_IMAGE" \
                        FRONTEND_IMAGE="$FRONTEND_IMAGE" \
                        IMAGE_SECURITY_OUTPUT_DIR=.artifacts/image-security \
                        IMAGE_SECURITY_WORK_ROOT=.artifacts/image-security-work \
                        TRIVY_REQUIRE_PREPARED=true \
                            sh scripts/scan-image-security.sh
                        sh scripts/record-ci-result.sh sbom-cve
                    '''
                }
            }
        }

        // Stages 6-8: 검사를 모두 통과한 full-SHA image만 release/로 승격한다.
        stage('Prepare release SBOM and vulnerability artifacts') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        IMAGE_SCANNER_MODE=required \
                            sh scripts/prepare-release-security-artifacts.sh
                        sh scripts/record-ci-result.sh release-security-artifacts
                    '''
                }
            }
        }

        stage('Create release image archive') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        sh scripts/create-release-image-archive.sh
                        sh scripts/record-ci-result.sh release-image-archive
                    '''
                }
            }
        }

        stage('Build metadata and release integrity') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        sh scripts/generate-build-metadata.sh
                        sh scripts/verify-release-artifacts.sh
                        sh scripts/record-ci-result.sh artifact-checksum
                    '''
                    archiveArtifacts(
                            artifacts: 'release/**',
                            allowEmptyArchive: false,
                            fingerprint: true
                    )
                }
            }
        }

        // Stage 9: 검증된 release/만 불변 incoming 경계로 전송한 뒤
        // root-owned helper가 자동으로 원자적 승격한다. 이 단계는 운영 배포가
        // 아니며, 운영 배포와 조건부 Rollback의 Jenkins 승인은 계속 유지한다.
        stage('Upload release artifacts to incoming') {
            steps {
                dir(env.APP_DIR) {
                    withCredentials([
                        sshUserPrivateKey(
                                credentialsId: 'gilbom-artifact-upload-ssh',
                                keyFileVariable: 'ARTIFACT_SSH_IDENTITY',
                                usernameVariable: 'ARTIFACT_SSH_USER'
                        ),
                        file(
                                credentialsId: 'gilbom-artifact-known-hosts',
                                variable: 'ARTIFACT_KNOWN_HOSTS'
                        )
                    ]) {
                        sh '''
                            set -eu
                            set +x
                            artifact_host="${ARTIFACT_HOST:-host.docker.internal}"
                            artifact_port="${ARTIFACT_SSH_PORT:-22}"
                            reuse_marker=.artifacts/ci-release-already-promoted
                            rm -f -- "$reuse_marker"
                            if KNOWN_HOSTS_FILE="$ARTIFACT_KNOWN_HOSTS" \
                               SSH_IDENTITY_FILE="$ARTIFACT_SSH_IDENTITY" \
                               SSH_PORT="$artifact_port" \
                                    sh scripts/check-ci-release-artifact-remote.sh \
                                        "$RELEASE_SHA" \
                                        "$ARTIFACT_SSH_USER@$artifact_host"
                            then
                                mkdir -p .artifacts
                                printf 'REUSED\\n' > "$reuse_marker"
                            else
                                lookup_status="$?"
                                [ "$lookup_status" -eq 10 ] \
                                    || exit "$lookup_status"
                                KNOWN_HOSTS_FILE="$ARTIFACT_KNOWN_HOSTS" \
                                SSH_IDENTITY_FILE="$ARTIFACT_SSH_IDENTITY" \
                                SSH_PORT="$artifact_port" \
                                REMOTE_ARTIFACT_ROOT=/opt/gilbom/artifacts \
                                    sh scripts/upload-ci-release-artifacts.sh \
                                        release \
                                        "$ARTIFACT_SSH_USER@$artifact_host"
                            fi
                            sh scripts/record-ci-result.sh artifact-upload
                        '''
                    }
                }
            }
        }

        stage('Promote release artifact automatically') {
            steps {
                dir(env.APP_DIR) {
                    withCredentials([
                        sshUserPrivateKey(
                                credentialsId: 'gilbom-artifact-upload-ssh',
                                keyFileVariable: 'ARTIFACT_SSH_IDENTITY',
                                usernameVariable: 'ARTIFACT_SSH_USER'
                        ),
                        file(
                                credentialsId: 'gilbom-artifact-known-hosts',
                                variable: 'ARTIFACT_KNOWN_HOSTS'
                        )
                    ]) {
                        sh '''
                            set -eu
                            set +x
                            if [ -f .artifacts/ci-release-already-promoted ]
                            then
                                echo "Automatic Artifact promotion: REUSED ($RELEASE_SHA)"
                            else
                                artifact_host="${ARTIFACT_HOST:-host.docker.internal}"
                                artifact_port="${ARTIFACT_SSH_PORT:-22}"
                                KNOWN_HOSTS_FILE="$ARTIFACT_KNOWN_HOSTS" \
                                SSH_IDENTITY_FILE="$ARTIFACT_SSH_IDENTITY" \
                                SSH_PORT="$artifact_port" \
                                    sh scripts/promote-ci-release-artifacts-remote.sh \
                                        "$RELEASE_SHA" \
                                        "$ARTIFACT_SSH_USER@$artifact_host"
                            fi
                            sh scripts/record-ci-result.sh artifact-promotion
                        '''
                    }
                }
            }
        }

        stage('Jenkins console Secret scan') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu
                        SECRET_SCAN_DIR=secrets \
                        JENKINS_LOG_SECURITY_OUTPUT_DIR=.artifacts/jenkins-log-security \
                            sh scripts/verify-jenkins-console-secret.sh
                        sh scripts/record-ci-result.sh jenkins-log-secret
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                if (env.APP_DIR) {
                    dir(env.APP_DIR) {
                        script {
                            env.CICD_BUILD_RESULT = currentBuild.currentResult ? currentBuild.currentResult : 'NOT_BUILT'
                        }
                        sh '''
                            set -eu
                            python3 scripts/generate-cicd-notification.py \
                                --pipeline ci \
                                --result "$CICD_BUILD_RESULT"
                        '''
                        script {
                            try {
                                withCredentials([
                                    string(
                                            credentialsId: 'gilbom-mattermost-webhook',
                                            variable: 'MATTERMOST_WEBHOOK_URL'
                                    )
                                ]) {
                                    sh '''
                                        set +x
                                        python3 \
                                            scripts/send-mattermost-notification.py \
                                            .artifacts/cicd-notification/mattermost-payload.json
                                    '''
                                }
                                writeFile(
                                        file: '.artifacts/cicd-notification/delivery.status',
                                        text: 'PASS\n'
                                )
                            } catch (Exception ignored) {
                                echo 'Mattermost notification skipped: configure '
                                        + 'gilbom-mattermost-webhook or check delivery'
                                writeFile(
                                        file: '.artifacts/cicd-notification/delivery.status',
                                        text: 'SKIPPED\n'
                                )
                            }
                        }
                        sh '''
                            set -eu
                            SECRET_SCAN_DIR=secrets \
                            JENKINS_LOG_SECURITY_OUTPUT_DIR=.artifacts/jenkins-log-security \
                                sh scripts/verify-jenkins-console-secret.sh
                            sh scripts/record-ci-result.sh jenkins-log-secret
                        '''
                        archiveArtifacts(
                                artifacts: '.artifacts/source-security/**,'
                                        + '.artifacts/image-security/**,'
                                        + '.artifacts/ci-results/**,'
                                        + '.artifacts/runtime/**,'
                                        + '.artifacts/jenkins-log-security/**,'
                                        + '.artifacts/cicd-notification/**',
                                allowEmptyArchive: true,
                                fingerprint: true
                        )
                        sh 'docker compose down --volumes --remove-orphans || true'
                    }
                }
                sh '''
                    set -eu
                    workspace_uid="$(id -u)"
                    workspace_gid="$(id -g)"
                    for mqtt_local in \
                        "$WORKSPACE/web/infra/mosquitto/local" \
                        "$WORKSPACE/infra/mosquitto/local"
                    do
                        [ -d "$mqtt_local" ] || continue
                        docker run --rm \
                            --user 0:0 \
                            --network none \
                            --read-only \
                            --cap-drop ALL \
                            --cap-add CHOWN \
                            --cap-add DAC_OVERRIDE \
                            --cap-add FOWNER \
                            --security-opt no-new-privileges:true \
                            --env WORKSPACE_UID="$workspace_uid" \
                            --env WORKSPACE_GID="$workspace_gid" \
                            --volume "$mqtt_local:/mqtt-local" \
                            --entrypoint /bin/sh \
                            eclipse-mosquitto:2.1.2-alpine \
                            -ec '
                                for target in /mqtt-local/ca /mqtt-local/runtime
                                do
                                    [ -d "$target" ] || continue
                                    [ ! -L "$target" ] || {
                                        echo "Refusing symlinked MQTT workspace target: $target" >&2
                                        exit 1
                                    }
                                    chown -R "$WORKSPACE_UID:$WORKSPACE_GID" "$target"
                                    chmod -R u+rwX "$target"
                                done
                            '
                    done
                '''
            }
        }
        unsuccessful {
            script {
                if (env.APP_DIR && env.RELEASE_SHA && env.BUILD_NUMBER) {
                    dir(env.APP_DIR) {
                        try {
                            withCredentials([
                                sshUserPrivateKey(
                                        credentialsId: 'gilbom-artifact-upload-ssh',
                                        keyFileVariable: 'ARTIFACT_SSH_IDENTITY',
                                        usernameVariable: 'ARTIFACT_SSH_USER'
                                ),
                                file(
                                        credentialsId: 'gilbom-artifact-known-hosts',
                                        variable: 'ARTIFACT_KNOWN_HOSTS'
                                )
                            ]) {
                                sh '''
                                    set +x
                                    artifact_host="${ARTIFACT_HOST:-host.docker.internal}"
                                    artifact_port="${ARTIFACT_SSH_PORT:-22}"
                                    KNOWN_HOSTS_FILE="$ARTIFACT_KNOWN_HOSTS" \
                                    SSH_IDENTITY_FILE="$ARTIFACT_SSH_IDENTITY" \
                                    SSH_PORT="$artifact_port" \
                                        sh scripts/quarantine-ci-release-artifacts-remote.sh \
                                            "$RELEASE_SHA" \
                                            "$BUILD_NUMBER" \
                                            "$ARTIFACT_SSH_USER@$artifact_host"
                                '''
                            }
                        } catch (Exception ignored) {
                            echo 'CI incoming quarantine skipped or failed; '
                                    + 'inspect the exact RELEASE_SHA before retrying'
                        }
                    }
                }
            }
        }
        cleanup {
            deleteDir()
        }
    }
}
