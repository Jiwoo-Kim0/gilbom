pipeline {
    agent any

    options {
        // 동일 Job의 이전 빌드가 같은 로컬 image tag를 덮어쓰지 않게 한다.
        disableConcurrentBuilds(abortPrevious: true)
        skipDefaultCheckout(true)
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    // 저장소 root가 common-proj인 경우와 web 자체인 경우를 모두 지원한다.
                    env.APP_DIR = fileExists('web/compose.yaml') ? 'web' : '.'
                    env.COMPOSE_PROJECT_NAME = (
                            "gilbom-ci-${env.JOB_NAME}-${env.BUILD_NUMBER}"
                                    .toLowerCase()
                                    .replaceAll('[^a-z0-9_-]', '-')
                                    .take(63)
                    )
                }
            }
        }

        stage('Prepare ephemeral credentials') {
            steps {
                script {
                    // CI 비밀번호는 빌드마다 메모리 환경 변수로 만들고 파일·artifact로 남기지 않는다.
                    env.POSTGRES_ADMIN_PASSWORD = sh(
                            script: 'openssl rand -hex 32',
                            returnStdout: true
                    ).trim()
                    env.POSTGRES_FLYWAY_PASSWORD = sh(
                            script: 'openssl rand -hex 32',
                            returnStdout: true
                    ).trim()
                    env.POSTGRES_APP_PASSWORD = sh(
                            script: 'openssl rand -hex 32',
                            returnStdout: true
                    ).trim()
                    env.MQTT_PASSWORD = sh(
                            script: 'openssl rand -hex 32',
                            returnStdout: true
                    ).trim()
                    env.MQTT_ROBOT_PASSWORD = sh(
                            script: 'openssl rand -hex 32',
                            returnStdout: true
                    ).trim()

                    // 검증은 컨테이너 내부에서 하므로 host port는 임의 포트(0)를 사용해 충돌을 피한다.
                    env.POSTGRES_PORT = '0'
                    env.BACKEND_PORT = '0'
                    env.FRONTEND_PORT = '0'
                    env.MQTT_TLS_PORT = '0'
                }
            }
        }

        stage('Repository policy') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu

                        # 실제 .env와 대표적인 개인키/keystore 확장자는 추적되면 즉시 실패시킨다.
                        if git ls-files --full-name \
                            | grep -E '(^|/)\\.env$|\\.(pem|key|p12|pfx|jks|keystore)$|(^|/)passwd$|(^|/)credentials\\.json$|(^|/)service-account[^/]*\\.json$'; then
                            echo 'Tracked secret file candidate detected.' >&2
                            exit 1
                        fi

                        # 대표적인 provider token과 PEM 개인키 본문이 일반 소스에 들어오면 CI에서 막는다.
                        if git grep -IlE -e \
                            'AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|glpat-[A-Za-z0-9_-]{20,}|github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}' \
                            -- . ':!frontend/gilbom/package-lock.json'; then
                            echo 'Tracked token candidate detected.' >&2
                            exit 1
                        fi
                        if git grep -IlE -e \
                            '-----BEGIN( [A-Z0-9]+)? PRIVATE KEY-----' \
                            -- . ':!backend/src/main/java/com/gilbom/robot/mqtt/strategy/PemSslContextSupport.java'; then
                            echo 'Tracked private key candidate detected.' >&2
                            exit 1
                        fi

                        # 필수 환경 변수가 모두 해석되는지도 image build 전에 확인한다.
                        docker compose config --quiet

                        # 개발자 선언과 Docker/lockfile의 지원 버전이 어긋나면 빌드하지 않는다.
                        sh scripts/verify-supported-versions.sh
                    '''
                }
            }
        }

        stage('Day 4 security acceptance') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu

                        project_dir="$(pwd)"
                        docker_socket_gid="$(
                            stat -c '%g' /var/run/docker.sock
                        )"

                        # Docker build 내부에서는 Testcontainers가 DB 테스트를
                        # 건너뛸 수 있으므로 socket을 연결한 별도 단계에서 실행한다.
                        docker run --rm \
                            --user "$(id -u):$(id -g)" \
                            --group-add "$docker_socket_gid" \
                            --add-host host.docker.internal:host-gateway \
                            --env DOCKER_HOST=unix:///var/run/docker.sock \
                            --env TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock \
                            --env TESTCONTAINERS_HOST_OVERRIDE=host.docker.internal \
                            --volume /var/run/docker.sock:/var/run/docker.sock \
                            --volume "$project_dir/backend:$project_dir/backend" \
                            --workdir "$project_dir/backend" \
                            amazoncorretto:21.0.12-alpine3.22 \
                            sh ./gradlew securityAcceptanceTest --no-daemon
                    '''
                }
            }
        }

        stage('Build and test images') {
            steps {
                dir(env.APP_DIR) {
                    // backend image는 Gradle test, frontend image는 lint와 production build를 포함한다.
                    sh 'docker compose build backend frontend mqtt-init'
                }
            }
        }

        stage('Integration smoke test') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        set -eu

                        # 단순 container 실행 여부가 아니라 모든 health dependency가 준비될 때까지 기다린다.
                        docker compose up --detach --no-build --wait --wait-timeout 180

                        # 프론트 Nginx -> 백엔드 API 경로를 호출해 실제 서비스 간 연결을 검증한다.
                        docker compose exec -T frontend \
                            wget -qO- http://127.0.0.1/api/health \
                            | grep -F '"status":"UP"'

                        # 전체 Actuator health에는 DB contributor가 포함돼 Backend -> DB 연결도 확인된다.
                        docker compose exec -T frontend \
                            wget -qO- http://backend:8080/actuator/health \
                            | grep -F '"status":"UP"'

                        # BrowserRouter deep link가 Nginx fallback을 통해 React 진입점으로 연결돼야 한다.
                        docker compose exec -T frontend \
                            wget -qO- http://127.0.0.1/robots \
                            | grep -F '<div id="root"></div>'

                        # 빈 DB의 extension, V1~V4, RBAC seed와 runtime 최소 권한을 계약 SQL로 확인한다.
                        docker compose exec -T db sh -ec '
                            export PGPASSWORD="$POSTGRES_PASSWORD"
                            psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" \
                                --no-password \
                                --set "flyway_role=$POSTGRES_FLYWAY_USER" \
                                --set "application_role=$POSTGRES_APP_USER"
                        ' < infra/postgres/verify-empty-database.sql

                        # 실제 CSRF 요청이 JDBC Session과 attribute를 DB에 쓰는지 확인한다.
                        docker compose exec -T frontend \
                            wget -qO- http://127.0.0.1/api/v1/auth/csrf-token \
                            | grep -Fq '"headerName":"X-CSRF-TOKEN"'
                        docker compose exec -T db sh -ec '
                            export PGPASSWORD="$POSTGRES_PASSWORD"
                            psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" \
                                --no-password --tuples-only --no-align --command "
                                    SELECT (
                                        (SELECT COUNT(*) FROM session_store.spring_session) >= 1
                                        AND
                                        (SELECT COUNT(*) FROM session_store.spring_session_attributes) >= 1
                                    )::int;
                                "
                        ' | grep -qx '1'

                        # Runtime role DML과 audit/report append-only 보호를 실제 권한으로 검증한다.
                        docker compose exec -T db sh -ec '
                            export PGPASSWORD="$POSTGRES_APP_PASSWORD"
                            psql --host 127.0.0.1 --username "$POSTGRES_APP_USER" \
                                --dbname "$POSTGRES_DB" --no-password
                        ' < infra/postgres/verify-initial-schema.sql
                        docker compose exec -T db sh -ec '
                            export PGPASSWORD="$POSTGRES_FLYWAY_PASSWORD"
                            psql --host 127.0.0.1 --username "$POSTGRES_FLYWAY_USER" \
                                --dbname "$POSTGRES_DB" --no-password
                        ' < infra/postgres/verify-append-only.sql
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                if (env.APP_DIR) {
                    dir(env.APP_DIR) {
                        // CI DB와 생성된 MQTT 자산은 재사용하지 않아 매번 빈 환경을 검증한다.
                        sh 'docker compose down --volumes --remove-orphans || true'
                    }
                }
            }
        }
        cleanup {
            deleteDir()
        }
    }
}
