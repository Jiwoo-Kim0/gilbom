# Backend direct execution from an IDE/terminal via spring-dotenv.
# Copy to backend/.env, fill every required blank password, and never commit it.
SPRING_PROFILES_ACTIVE=local

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gilbom
SPRING_DATASOURCE_USERNAME=gilbom_app
SPRING_DATASOURCE_PASSWORD=
SPRING_FLYWAY_USER=gilbom_flyway
SPRING_FLYWAY_PASSWORD=

# HTTP request safety limits.
GILBOM_MAX_REQUEST_BODY_SIZE=1MB
GILBOM_MAX_REQUEST_HEADER_SIZE=16KB
GILBOM_MAX_UPLOAD_FILE_SIZE=500KB

# Keep disabled until a real 32-byte Base64 key is supplied in the ignored .env.
MFA_TOTP_SECRET_ENCRYPTION_ENABLED=false
MFA_TOTP_SECRET_ACTIVE_KEY_VERSION=1
MFA_TOTP_SECRET_KEYRING=

MQTT_BROKER=ssl://localhost:8883
MQTT_CLIENT_ID=gilbom-local-ide
MQTT_USERNAME=gilbom
MQTT_PASSWORD=
# Relative to the backend working directory. Use an absolute path if the IDE uses another directory.
MQTT_TRUST_CERTIFICATE=../infra/mosquitto/local/runtime/certs/local-ca-cert.pem
# Reserved for the later mTLS phase.
MQTT_CLIENT_CERTIFICATE=
MQTT_CLIENT_PRIVATE_KEY=
MQTT_SUBSCRIBE_TOPIC=tbs/v2/robots/+/presence,tbs/v2/robots/+/state,tbs/v2/robots/+/telemetry,tbs/v2/robots/+/events/#,tbs/v2/robots/+/commands/result
MQTT_PUBLISH_TOPIC=tbs/v2/robots/robot-test/commands/request
MQTT_QOS=1

TZ=UTC

NAVER_MAP_CLIENT_ID=...
NAVER_MAP_CLIENT_SECRET=...