# 로컬 MQTT 로봇 테스트용 공개 설정
# 실제 실행 파일은 이 파일을 `로봇-config.local.env`로 복사해서 사용한다.
# `MQTT_PASSWORD`에는 web/.env의 MQTT_ROBOT_PASSWORD와 같은 값을 로컬에서만 넣는다.

# 로봇 등록 요청 데이터
ROBOT_NAME=점자블록 순찰 로봇 1호
ROBOT_SERIAL_NUMBER=SN-JETSON-0001

# 등록 API 성공 응답의 robotCode를 사용한다.
# 로컬 초기 테스트의 기본 예시는 RBT-001이다.
ROBOT_ID=RBT-001
ROBOT_CODE=RBT-001

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=8883
MQTT_USERNAME=RBT-001
MQTT_PASSWORD=
MQTT_CLIENT_ID=RBT-001
MQTT_KEEPALIVE_SEC=30
MQTT_QOS=1
MQTT_SCHEMA_VERSION=2.0

# TLS
MQTT_TLS_ENABLED=true
MQTT_TLS_VERIFY_HOSTNAME=true
MQTT_CA_CERT=../../infra/mosquitto/local/runtime/certs/local-ca-cert.pem

# 로봇이 발행하는 Topic
MQTT_TOPIC_PRESENCE=tbs/v2/robots/RBT-001/presence
MQTT_TOPIC_STATE=tbs/v2/robots/RBT-001/state
MQTT_TOPIC_TELEMETRY=tbs/v2/robots/RBT-001/telemetry
MQTT_TOPIC_EVENT_INCIDENT=tbs/v2/robots/RBT-001/events/incident
MQTT_TOPIC_EVENT_BATTERY=tbs/v2/robots/RBT-001/events/battery
MQTT_TOPIC_EVENT_SAFETY=tbs/v2/robots/RBT-001/events/safety
MQTT_TOPIC_EVENT_MISSION=tbs/v2/robots/RBT-001/events/mission
MQTT_TOPIC_COMMAND_RESULT=tbs/v2/robots/RBT-001/commands/result

# 로봇이 구독하는 Topic
MQTT_TOPIC_COMMAND_REQUEST=tbs/v2/robots/RBT-001/commands/request
MQTT_TOPIC_INGEST_RECEIPT=tbs/v2/robots/RBT-001/ingest/receipt
