{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gilbom.example/contracts/mqtt/v2/schemas/command-request.schema.json",
  "title": "길봄 MQTT v2 Command Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "command_type",
    "issued_at",
    "expires_at",
    "requested_by",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/definitions/schemaVersion"
    },
    "command_id": {
      "$ref": "common.schema.json#/definitions/uuidV4"
    },
    "command_type": {
      "type": "string",
      "enum": [
        "START_MISSION",
        "PAUSE_MISSION",
        "RESUME_MISSION",
        "COMPLETE_MISSION",
        "CANCEL_MISSION",
        "EMERGENCY_STOP",
        "CLEAR_EMERGENCY_STOP"
      ]
    },
    "issued_at": {
      "$ref": "common.schema.json#/definitions/utcDateTime"
    },
    "expires_at": {
      "$ref": "common.schema.json#/definitions/utcDateTime"
    },
    "requested_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_type",
        "actor_id"
      ],
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": [
            "ADMIN",
            "SYSTEM"
          ]
        },
        "actor_id": {
          "$ref": "common.schema.json#/definitions/nonBlankString"
        }
      }
    },
    "parameters": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "command_type": {
          "const": "START_MISSION"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mission_id",
            "zone_id"
          ],
          "properties": {
            "mission_id": {
              "$ref": "common.schema.json#/definitions/nonBlankString"
            },
            "zone_id": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "properties": {
        "command_type": {
          "enum": [
            "PAUSE_MISSION",
            "EMERGENCY_STOP",
            "CLEAR_EMERGENCY_STOP"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "$ref": "common.schema.json#/definitions/nonBlankString"
            }
          }
        }
      }
    },
    {
      "properties": {
        "command_type": {
          "const": "CANCEL_MISSION"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mission_id",
            "reason"
          ],
          "properties": {
            "mission_id": {
              "$ref": "common.schema.json#/definitions/nonBlankString"
            },
            "reason": {
              "$ref": "common.schema.json#/definitions/nonBlankString"
            }
          }
        }
      }
    },
    {
      "properties": {
        "command_type": {
          "enum": [
            "RESUME_MISSION",
            "COMPLETE_MISSION"
          ]
        },
        "parameters": {
          "type": "object",
          "maxProperties": 0
        }
      }
    }
  ]
}
