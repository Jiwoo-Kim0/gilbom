{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gilbom.example/contracts/mqtt/v2/schemas/mission-event.schema.json",
  "title": "길봄 MQTT v2 Mission Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "mqtt_id",
    "boot_id",
    "seq",
    "source_component",
    "occurred_at",
    "sent_at",
    "ttl_sec",
    "mission_id"
  ],
  "properties": {
    "schema_version": {},
    "event_id": {},
    "event_type": {
      "type": "string",
      "enum": [
        "MISSION_STARTED",
        "MISSION_PAUSED",
        "MISSION_RESUMED",
        "MISSION_COMPLETED",
        "MISSION_CANCELLED",
        "MISSION_FAILED"
      ]
    },
    "mqtt_id": {},
    "boot_id": {},
    "seq": {},
    "source_component": {
      "const": "mission"
    },
    "occurred_at": {},
    "sent_at": {},
    "ttl_sec": {},
    "mission_id": {
      "$ref": "common.schema.json#/definitions/nonBlankString"
    },
    "causation_command_id": {
      "$ref": "common.schema.json#/definitions/uuidV4"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_sec",
        "incident_count",
        "normal_detection_count",
        "completion_reason"
      ],
      "properties": {
        "duration_sec": {
          "type": "integer",
          "minimum": 0
        },
        "incident_count": {
          "type": "integer",
          "minimum": 0
        },
        "normal_detection_count": {
          "type": "integer",
          "minimum": 0
        },
        "completion_reason": {
          "$ref": "common.schema.json#/definitions/nonBlankString"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "event-envelope.schema.json"
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "MISSION_COMPLETED",
              "MISSION_CANCELLED",
              "MISSION_FAILED"
            ]
          }
        }
      },
      "then": {
        "required": [
          "result"
        ]
      },
      "else": {
        "not": {
          "required": [
            "result"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "MISSION_COMPLETED"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "causation_command_id"
          ]
        }
      }
    }
  ]
}
