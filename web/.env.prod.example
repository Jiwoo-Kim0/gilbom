# Production runtime configuration template.
# Copy this file to the ignored .env.prod. Never put Secret values here.
# Secret variables below are host file paths; containers receive read-only
# mounts under /run/secrets.

COMPOSE_PROJECT_NAME=gilbom-prod
SPRING_PROFILES_ACTIVE=ec2,docker
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=20s
# 기본 운영은 MQTT 장애 중에도 DB 기반 관리 기능을 제공한다. 로봇 기능이 전체
# 서비스의 필수 조건인 배포만 마지막에 ,mqttConnection을 추가한다. LLM은
# template fallback 대상이므로 이 목록에 넣지 않는다.
GILBOM_HEALTH_READINESS_COMPONENTS=readinessState,db,flywayReadiness,storageReadiness
TZ=UTC

# Published ports. Restrict MQTT_BIND_ADDRESS and the host firewall to robot
# source networks. Put TLS at the load balancer in front of Frontend port 80.
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_HTTP_PORT=80
MQTT_BIND_ADDRESS=0.0.0.0
MQTT_TLS_PORT=8883

# Local verification defaults. Production release must replace both values with
# immutable registry references such as registry.example/gilbom/backend@sha256:...
BACKEND_IMAGE=gilbom-backend:local
FRONTEND_IMAGE=gilbom-frontend:local

POSTGRES_DB=gilbom
POSTGRES_ADMIN_USER=gilbom_db_admin
POSTGRES_ADMIN_PASSWORD_SECRET_FILE=./secrets/postgres_admin_password
POSTGRES_FLYWAY_USER=gilbom_flyway
POSTGRES_FLYWAY_PASSWORD_SECRET_FILE=./secrets/postgres_flyway_password
POSTGRES_APP_USER=gilbom_app
POSTGRES_APP_PASSWORD_SECRET_FILE=./secrets/postgres_app_password
MOSQUITTO_TLS_FULLCHAIN_FILE
# MQTT backend password must match the gilbom hash in mosquitto_passwd. 
MQTT_CLIENT_ID=gilbom-backend-prod
MQTT_USERNAME=gilbom
MQTT_PASSWORD_SECRET_FILE=./secrets/mqtt_backend_password
MQTT_CA_CERTIFICATE_FILE=/etc/ssl/certs/ca-certificates.crt
# Must match the Broker certificate SAN. Docker data-network DNS uses it as
# an alias, so Backend TLS stays internal without weakening hostname checks.
MQTT_TLS_SERVER_NAME=i15d101.p.ssafy.io
MQTT_PUBLIC_BROKER_URI=ssl://i15d101.p.ssafy.io:8883
MQTT_CREDENTIAL_PROVISIONING_ENABLED=true # Compose 실행하고 모스키토 Healthy면 true로 하시오
MQTT_CONNECT_COMPLETION_TIMEOUT=10s
MQTT_DISCONNECT_COMPLETION_TIMEOUT=5s

# The Mosquitto passwd file is hashed but still sensitive.
MOSQUITTO_PASSWORD_FILE_SECRET_FILE=./secrets/mosquitto_passwd
MOSQUITTO_TLS_FULLCHAIN_FILE=/opt/gilbom/mosquitto/certs/fullchain.pem
MOSQUITTO_TLS_PRIVATE_KEY_SECRET_FILE=/opt/gilbom/mosquitto/certs/privkey.pem

GILBOM_STORAGE_SIGNING_KEY_SECRET_FILE=./secrets/gilbom_storage_signing_key
AUTH_RATE_LIMIT_HMAC_KEY_VERSION=1
AUTH_RATE_LIMIT_HMAC_KEY_SECRET_FILE=./secrets/gilbom_auth_rate_limit_hmac_key
MFA_TOTP_SECRET_ENCRYPTION_ENABLED=true
MFA_TOTP_SECRET_ACTIVE_KEY_VERSION=1
MFA_TOTP_KEYRING_SECRET_FILE=./secrets/gilbom_mfa_totp_keyring

INITIAL_ADMIN_BOOTSTRAP_ENABLED=false
INITIAL_ADMIN_EMAIL=
# 비활성 환경에서는 빈 파일을 사용할 수 있다. 최초 기동에서 활성화할 때만
# non-empty password를 넣고 관리자 생성·비밀번호 변경 뒤 다시 비활성화한다.
INITIAL_ADMIN_PASSWORD_SECRET_FILE=./secrets/gilbom_initial_admin_password
INITIAL_ADMIN_DISPLAY_NAME=
INITIAL_ADMIN_USER_CODE=

GILBOM_LLM_ENABLED=false
GILBOM_LLM_PROVIDER=GMS
GILBOM_LLM_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
GILBOM_LLM_MODEL=
# LLM 비활성 환경에서는 이 줄을 제거해 /dev/null 빈 Secret mount를 사용할 수 있다.
# 활성화할 때는 반드시 실제 key file 경로를 지정한다.
GILBOM_LLM_API_KEY_SECRET_FILE=./secrets/gilbom_llm_api_key
GILBOM_LLM_CONNECT_TIMEOUT=3s
GILBOM_LLM_READ_TIMEOUT=30s
GILBOM_LLM_MAX_OUTPUT_TOKENS=1500
GILBOM_LLM_DAILY_REQUEST_LIMIT=0
GILBOM_LLM_DAILY_BUDGET=0
GILBOM_LLM_MAX_CONCURRENT_REQUESTS=5
GILBOM_LLM_PROMPT_VERSION=
GILBOM_LLM_POLICY_APPROVED=false
GILBOM_LLM_TRAINING_EXCLUSION_APPROVED=false
GILBOM_LLM_DATA_RETENTION_APPROVED=false
GILBOM_LLM_OUTBOUND_ALLOWLIST_APPLIED=false
GILBOM_LLM_IMAGE_INPUT_ENABLED=false
GILBOM_LLM_IMAGE_DEIDENTIFICATION_APPROVED=false

GILBOM_CORS_ENABLED=false
GILBOM_CORS_ALLOWED_ORIGINS=
GILBOM_CORS_ALLOW_CREDENTIALS=true

# Public browser identifier. Never place DB/MQTT/LLM/signing Secrets in VITE_*.
VITE_NAVER_MAP_CLIENT_ID=

# Initial conservative container ceilings; tune from production telemetry.
POSTGRES_CPUS=2.0
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_MEMORY_RESERVATION=512m
POSTGRES_PIDS_LIMIT=256
POSTGRES_SHM_SIZE=256m
BACKEND_CPUS=2.0
BACKEND_MEMORY_LIMIT=2g
BACKEND_MEMORY_RESERVATION=512m
BACKEND_PIDS_LIMIT=256
FRONTEND_CPUS=0.5
FRONTEND_MEMORY_LIMIT=128m
FRONTEND_MEMORY_RESERVATION=32m
FRONTEND_PIDS_LIMIT=64
MQTT_CPUS=1.0
MQTT_MEMORY_LIMIT=256m
MQTT_MEMORY_RESERVATION=64m
MQTT_PIDS_LIMIT=128
MQTT_INIT_CPUS=0.25
MQTT_INIT_MEMORY_LIMIT=64m
MQTT_INIT_PIDS_LIMIT=32

LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
