# Copy this file to .env before running Docker Compose.
# Never commit the real .env file.

COMPOSE_PROJECT_NAME=gilbom

POSTGRES_DB=gilbom
POSTGRES_USER=gilbom_app
POSTGRES_PASSWORD=replace_with_a_strong_local_password
POSTGRES_PORT=5432
BACKEND_PORT=8080

# The database stores timestamps in UTC.
TZ=UTC
