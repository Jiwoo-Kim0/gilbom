# Local Docker development only.
# 1) Copy to .env, 2) fill every required blank password, 3) never commit .env.
# Staging/production values must come from the approved external secret store.

COMPOSE_PROJECT_NAME=gilbom
SPRING_PROFILES_ACTIVE=local,docker

POSTGRES_DB=gilbom
# Bootstrap, migration, runtime role은 서로 다른 비밀번호를 사용한다.
POSTGRES_ADMIN_USER=gilbom_db_admin
POSTGRES_ADMIN_PASSWORD=
POSTGRES_FLYWAY_USER=gilbom_flyway
POSTGRES_FLYWAY_PASSWORD=
POSTGRES_APP_USER=gilbom_app
POSTGRES_APP_PASSWORD=
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# HTTP request safety limits. Nginx keeps an independent hard 1MiB edge ceiling.
GILBOM_MAX_REQUEST_BODY_SIZE=1MB
GILBOM_MAX_REQUEST_HEADER_SIZE=16KB
GILBOM_MAX_UPLOAD_FILE_SIZE=500KB
# 승인 PDF 내부 저장 경로. Compose named volume 경로를 유지한다.
GILBOM_REPORT_PDF_STORAGE_ROOT=/app/data/report-pdf
# 보고서 SSE 연결 상한. heartbeat는 계약상 15초로 고정한다.
GILBOM_REPORT_SSE_MAX_CONNECTIONS_PER_USER=3
GILBOM_REPORT_SSE_MAX_CONNECTIONS_TOTAL=200
# S3 전환 전 결함 이미지 저장 경로. Compose named volume 경로를 유지한다.
GILBOM_STORAGE_LOCAL_ROOT_DIRECTORY=/app/data/robot-images
# 최소 32 random bytes를 Base64로 인코딩해 ignored .env/외부 Secret에만 입력한다.
GILBOM_STORAGE_URL_SIGNING_KEY_BASE64=
# Nginx /api proxy를 사용하면 false로 둔다. 교차 Origin이 필요할 때만 exact Origin을 쉼표로 구분한다.
GILBOM_CORS_ENABLED=false
GILBOM_CORS_ALLOWED_ORIGINS=
GILBOM_CORS_ALLOW_CREDENTIALS=true
GILBOM_SESSION_IDLE_TIMEOUT=30m
GILBOM_SESSION_ABSOLUTE_TIMEOUT=8h
GILBOM_MFA_CHALLENGE_TIMEOUT=5m
GILBOM_SESSION_MAX_CONCURRENT=1
GILBOM_MFA_CHALLENGE_MAX_FAILURES=5
GILBOM_SESSION_CLEANUP_INTERVAL=1m
GILBOM_SESSION_CLEANUP_BATCH_SIZE=1000

# Initial administrator bootstrap. Enable only for the first empty-DB creation.
# The password must be 10-24 characters and must never be committed.
INITIAL_ADMIN_BOOTSTRAP_ENABLED=false
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_DISPLAY_NAME=
INITIAL_ADMIN_USER_CODE=

# Public authentication Rate Limit HMAC.
# Generate at least 32 random bytes and Base64-encode them; never commit the real value.
AUTH_RATE_LIMIT_HMAC_KEY_VERSION=1
AUTH_RATE_LIMIT_HMAC_KEY_BASE64=
AUTH_CSRF_TOKEN_ISSUANCE_MAX_REQUESTS=60
AUTH_CSRF_TOKEN_ISSUANCE_WINDOW=1m
AUTH_EMAIL_AVAILABILITY_MAX_REQUESTS=20
AUTH_EMAIL_AVAILABILITY_WINDOW=1m
AUTH_REGISTRATION_MAX_REQUESTS=5
AUTH_REGISTRATION_WINDOW=1h
AUTH_IP_MAX_REQUESTS=20
AUTH_IP_WINDOW=1m
AUTH_PASSWORD_MAX_FAILURES=5
AUTH_PASSWORD_FAILURE_WINDOW=15m
AUTH_MFA_MAX_FAILURES=5
AUTH_MFA_FAILURE_WINDOW=15m
AUTH_TEMPORARY_LOCK_DURATION=15m
AUTH_RATE_LIMIT_CLEANUP_INTERVAL=10m
AUTH_RATE_LIMIT_CLEANUP_BATCH_SIZE=1000

# TOTP Secret AES-256-GCM envelope encryption.
# MFA 암호화 테스트 시에만 true로 바꾸고 keyring은 ignored .env에만 입력한다.
MFA_TOTP_SECRET_ENCRYPTION_ENABLED=false
MFA_TOTP_SECRET_ACTIVE_KEY_VERSION=1
# Format: 1=<32-byte-key-base64>;2=<32-byte-key-base64>
MFA_TOTP_SECRET_KEYRING=

# Local MQTT TLS accounts. Blank passwords make Compose fail until explicitly filled.
MQTT_BROKER=ssl://mosquitto:8883
MQTT_CLIENT_ID=gilbom-local-docker
MQTT_USERNAME=gilbom
MQTT_PASSWORD=
# Local smoke-test bootstrap account only. Registered RBT-* accounts are generated by the credential API.
MQTT_ROBOT_USERNAME=robot-test
MQTT_ROBOT_PASSWORD=
# Public local CA certificate mounted into the backend container.
MQTT_TRUST_CERTIFICATE=/app/config/mqtt/certs/local-ca-cert.pem
MQTT_SUBSCRIBE_TOPIC=tbs/v2/robots/+/presence,tbs/v2/robots/+/state,tbs/v2/robots/+/telemetry,tbs/v2/robots/+/events/#,tbs/v2/robots/+/commands/result
MQTT_PUBLISH_TOPIC=tbs/v2/robots/robot-test/commands/request
MQTT_QOS=1
# URI given to a newly provisioned robot. Use the PC's reachable IP or public DNS.
MQTT_PUBLIC_BROKER_URI=ssl://localhost:8883
MQTT_CREDENTIAL_PROVISIONING_ENABLED=true
MQTT_CREDENTIAL_PASSWORD_FILE=/app/config/mqtt/credentials/passwd
MQTT_CREDENTIAL_PASSWORD_COMMAND=mosquitto_passwd
MQTT_TLS_PORT=8883
# 기본값은 이 PC에서만 접속 가능하다.
MQTT_BIND_ADDRESS=127.0.0.1
# 팀원 PC와 같은 LAN에서 통신할 때만 위 값을 0.0.0.0으로 바꾸고,
# 아래에는 Broker PC의 실제 LAN IPv4를 넣는다. 예: 192.168.100.191
MQTT_LAN_IP=
# ngrok TCP를 사용할 때 tcp://를 제외한 hostname만 넣는다.
# 예: 0.tcp.ap.ngrok.io (할당된 port는 MQTT Client에 별도로 설정)
MQTT_PUBLIC_HOSTNAME=

# Naver Map API Key
VITE_NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# GMS LLM. false이면 나머지 값이 비어 있어도 서버는 기동하며 TEMPLATE만 사용한다.
GILBOM_LLM_ENABLED=false
GILBOM_LLM_PROVIDER=GMS
GILBOM_LLM_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
GILBOM_LLM_MODEL=gpt-5.4-mini
GILBOM_LLM_API_KEY=
GILBOM_LLM_CONNECT_TIMEOUT=3s
GILBOM_LLM_READ_TIMEOUT=30s
GILBOM_LLM_MAX_OUTPUT_TOKENS=1500
GILBOM_LLM_DAILY_REQUEST_LIMIT=0
GILBOM_LLM_DAILY_BUDGET=0
GILBOM_LLM_MAX_CONCURRENT_REQUESTS=5
GILBOM_LLM_PROMPT_VERSION=report-v1
# 아래 승인은 실제 정책·egress 적용을 확인한 운영 담당자만 true로 바꾼다.
GILBOM_LLM_POLICY_APPROVED=false
GILBOM_LLM_TRAINING_EXCLUSION_APPROVED=false
GILBOM_LLM_DATA_RETENTION_APPROVED=false
GILBOM_LLM_OUTBOUND_ALLOWLIST_APPLIED=false
# 둘 다 true일 때만 대표 이미지 1장을 메모리에서 Base64로 변환해 전송한다.
GILBOM_LLM_IMAGE_INPUT_ENABLED=false
GILBOM_LLM_IMAGE_DEIDENTIFICATION_APPROVED=false

# Application and database timestamps use UTC.
TZ=UTC
