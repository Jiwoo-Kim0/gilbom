# Local/docker development only. Staging and production must use the
# environment and secret strategy in docs/environment-configuration-strategy.md.
# Copy this file to .env before running Docker Compose.
# Never commit the real .env file.

COMPOSE_PROJECT_NAME=gilbom

POSTGRES_DB=gilbom
# DB bootstrap, migration, runtime role을 분리한다. 실제 값은 서로 다른 비밀번호를 사용한다.
POSTGRES_ADMIN_USER=gilbom_db_admin
POSTGRES_ADMIN_PASSWORD=replace_with_a_strong_local_admin_password
POSTGRES_FLYWAY_USER=gilbom_flyway
POSTGRES_FLYWAY_PASSWORD=replace_with_a_strong_local_flyway_password
POSTGRES_APP_USER=gilbom_app
POSTGRES_APP_PASSWORD=replace_with_a_strong_local_app_password
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# TOTP Secret AES-256-GCM envelope encryption.
# 로컬 MFA 암호화 테스트 시에만 enabled=true로 바꾸고 실제 key는 ignored .env에 입력한다.
MFA_TOTP_SECRET_ENCRYPTION_ENABLED=false
MFA_TOTP_SECRET_ACTIVE_KEY_VERSION=1
# 형식: 1=<32-byte-key-base64>;2=<32-byte-key-base64>
# rotation 중에는 DB에 남은 모든 key version을 유지한다.
MFA_TOTP_SECRET_KEYRING=

# MQTT connection used by web/compose.yaml.
MQTT_BROKER=ssl://mosquitto:8883
MQTT_CLIENT_ID=gilbom-local-docker
MQTT_USERNAME=gilbom
MQTT_PASSWORD=gilbom
MQTT_ROBOT_USERNAME=robot-test
MQTT_ROBOT_PASSWORD=gilbom
MQTT_SUBSCRIBE_TOPIC=robots/+/telemetry,robots/+/commands/ack
MQTT_PUBLISH_TOPIC=robots/test-robot/commands
MQTT_QOS=1
MQTT_TLS_PORT=8883

# The database stores timestamps in UTC.
TZ=UTC
