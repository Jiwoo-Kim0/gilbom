.git

# Environment files and runtime Secret sources
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
secrets/
**/secrets/

# Private keys and keystores
**/*.key
**/*-key.pem
**/*_key.pem
**/privkey.pem
**/*private*.pem
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore

# Build and test output
**/node_modules/
**/dist/
**/dist-ssr/
**/coverage/
**/test-results/
**/playwright-report/
**/.nyc_output/
**/*.log

# IDE and OS files
**/.idea/
**/.vscode/
**/.settings/
**/*.iml
**/.DS_Store
