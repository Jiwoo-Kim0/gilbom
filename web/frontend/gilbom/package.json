{
  "name": "gilbom",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "preview": "vite preview",
    "test:e2e:mission": "playwright test e2e/mission-time.spec.ts e2e/mission-map.spec.ts e2e/patrol-area-registration.spec.ts",
    "test:e2e:defect": "playwright test e2e/defect-list.spec.ts e2e/defect-filter.spec.ts e2e/defect-search.spec.ts e2e/defect-cluster.spec.ts e2e/defect-realtime-map.spec.ts e2e/defect-focus-zoom.spec.ts e2e/defect-edit.spec.ts e2e/defect-zoom-out-close.spec.ts",
    "test:e2e:mission:live": "playwright test e2e/mission-time-live.spec.ts --config=playwright.live.config.ts"
  },
  "dependencies": {
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
