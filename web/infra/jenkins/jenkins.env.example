JENKINS_PROJECT_NAME=gilbom-jenkins
JENKINS_BIND_ADDRESS=127.0.0.1
JENKINS_HTTP_PORT=8081
JENKINS_HOME_DIR=/opt/jenkins/home
JENKINS_IMAGE=gilbom-jenkins:2.555.3-docker-29.6.2

JENKINS_CPUS=2.0
JENKINS_MEMORY_LIMIT=2g
JENKINS_MEMORY_RESERVATION=512m
JENKINS_PIDS_LIMIT=512

JENKINS_DIND_CPUS=2.0
JENKINS_DIND_MEMORY_LIMIT=4g
JENKINS_DIND_MEMORY_RESERVATION=512m
JENKINS_DIND_PIDS_LIMIT=512

JENKINS_LOG_MAX_SIZE=10m
JENKINS_LOG_MAX_FILES=3
