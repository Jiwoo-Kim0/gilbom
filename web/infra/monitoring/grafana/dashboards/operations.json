{
  "uid": "gilbom-operations",
  "title": "길봄 · 운영",
  "tags": ["gilbom", "operations"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "마지막 Backup 성공",
      "description": "매일 도는 timer다. 30시간을 넘으면 BackupStale 알람이 뜬다.",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "dateTimeFromNow" },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{backup}}",
          "expr": "gilbom_backup_last_success_seconds * 1000"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "마지막 Backup 결과",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "실패", "color": "red", "index": 0 },
                "1": { "text": "성공", "color": "green", "index": 1 }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{backup}}",
          "expr": "gilbom_backup_last_status"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "마지막 Off-host 반출",
      "description": "EC2가 통째로 사라지면 로컬 backup도 함께 사라진다.",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "dateTimeFromNow" },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{backup}}",
          "expr": "gilbom_backup_offhost_exported_seconds * 1000"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "TLS 인증서 만료까지",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 432000 },
              { "color": "green", "value": 1209600 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        { "refId": "A", "expr": "probe_ssl_earliest_cert_expiry - time()" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "마지막 배포",
      "description": "Jenkins 성공·실패 통지 자체는 기존 Mattermost CI/CD 알림이 담당한다.",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "dateTimeFromNow" },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        { "refId": "A", "expr": "gilbom_deploy_last_success_seconds * 1000" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Backup 저장 용량",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        { "refId": "A", "expr": "gilbom_path_usage_bytes{path=\"backups\"}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Backup 소요 시간",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "auto" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{backup}}",
          "expr": "gilbom_backup_last_duration_seconds"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HTTPS probe 응답 시간",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "응답 시간",
          "expr": "probe_duration_seconds{job=\"blackbox-https\"}"
        }
      ]
    }
  ]
}
