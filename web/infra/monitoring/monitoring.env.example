MONITORING_PROJECT_NAME=gilbom-monitoring
MONITORING_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
GRAFANA_PORT=3001
ALLOY_PORT=12345

# 운영 Compose가 만든 internal app network의 실제 이름이다. Prometheus가 Backend를
# 긁으려면 이 network에 함께 있어야 한다. 운영 project 이름이 gilbom이면 gilbom_app이다.
APP_NETWORK_NAME=gilbom_app
# host가 metric을 써 넣고 Alloy가 read-only로 읽는 디렉터리다.
MONITORING_TEXTFILE_DIR=/opt/gilbom/monitoring/textfile

PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=2GB
PROMETHEUS_CPUS=0.5
PROMETHEUS_MEMORY_LIMIT=512m
PROMETHEUS_MEMORY_RESERVATION=128m
PROMETHEUS_PIDS_LIMIT=128

ALERTMANAGER_CPUS=0.25
ALERTMANAGER_MEMORY_LIMIT=128m
ALERTMANAGER_MEMORY_RESERVATION=32m
ALERTMANAGER_PIDS_LIMIT=64
# Mattermost incoming webhook URL 한 줄만 담는다. 값은 저장소에 넣지 않는다.
ALERTMANAGER_WEBHOOK_SECRET_FILE=/opt/gilbom/secrets/alertmanager_mattermost_webhook

# HTTPS probe 대상 도메인. blackbox container 안에서 host-gateway로 해석된다.
PROBE_DOMAIN=i15d101.p.ssafy.io
BLACKBOX_CPUS=0.25
BLACKBOX_MEMORY_LIMIT=64m
BLACKBOX_MEMORY_RESERVATION=16m
BLACKBOX_PIDS_LIMIT=64

LOKI_CPUS=0.5
LOKI_MEMORY_LIMIT=512m
LOKI_MEMORY_RESERVATION=128m
LOKI_PIDS_LIMIT=128

GRAFANA_CPUS=0.5
GRAFANA_MEMORY_LIMIT=256m
GRAFANA_MEMORY_RESERVATION=64m
GRAFANA_PIDS_LIMIT=128
GRAFANA_ADMIN_USER=gilbom-admin
GRAFANA_COOKIE_SECURE=false
GRAFANA_ADMIN_PASSWORD_SECRET_FILE=/opt/gilbom/secrets/grafana_admin_password

ALLOY_CPUS=0.5
ALLOY_MEMORY_LIMIT=256m
ALLOY_MEMORY_RESERVATION=64m
ALLOY_PIDS_LIMIT=128
ALLOY_LOG_CPUS=0.25
ALLOY_LOG_MEMORY_LIMIT=128m
ALLOY_LOG_MEMORY_RESERVATION=32m
ALLOY_LOG_PIDS_LIMIT=96
ALLOY_INIT_CPUS=0.25
ALLOY_INIT_MEMORY_LIMIT=64m
ALLOY_INIT_PIDS_LIMIT=32

MONITORING_LOG_MAX_SIZE=10m
MONITORING_LOG_MAX_FILES=3
