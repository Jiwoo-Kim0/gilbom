__pycache__/
*.py[cod]

# EC2 host-specific runtime configuration is copied out-of-band.
.envEC2

# MQTT 통신 테스트 패키지 — .env·connection-secret.md 에 브로커 비밀번호가 들어 있다.
# 전달받은 그대로 두고 커밋하지 않는다 (패키지 README 11항).
gilbom-mqtt-external-test/

# 개인 일일 작업·Jira 기록은 기본적으로 제외한다.
# Day 7 실제 장비 통합 계획 두 건은 팀 공유 문서이므로 예외로 추적한다.
DailyLog/*
!DailyLog/2026-07-31_Day7_상세_구현.md
!DailyLog/2026-07-31_JIRA_Day7_작업.md

# Codex 격리 Gradle 빌드 산출물
/web/backend/build-codex-*/

# Windows download metadata
*:Zone.Identifier

# ── 임베디드: 밀리면 안 되는 것들 ─────────────────────────────────────────────
# 실 Credential 주입 파일 — MQTT_PASSWORD·API Key 가 들어간다. example 만 추적한다.
embedded/scripts/orincar.env
# 비밀값 .env 전부 (스모크 도구·목 로봇이 옆에 만드는 것 포함)
embedded/**/.env
test/통신테스트/.env
# 로봇 런타임 데이터 — Outbox(sqlite)·증거 이미지 (embedded/var/)
embedded/var/*
!embedded/var/evidence/
embedded/var/evidence/*
!embedded/var/evidence/README.md
embedded/**/*.sqlite3
# 카메라 녹화물 — 용량 크고 현장 영상이다
embedded/DataRecorder/recordings/
# 모델 변환 산출물 — Jetson 에서 생성되는 수백 MB 바이너리
embedded/**/*.engine
embedded/**/*.onnx
